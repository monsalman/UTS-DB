generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model employees {
  id           Int            @id @default(autoincrement())
  username     String         @unique @db.VarChar(50)
  password     String
  role         String?        @default("employee") @db.VarChar(20)
  transactions transactions[]
}

model products {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  category    String    @db.VarChar(50)
  price       Decimal   @db.Decimal(12, 2)
  image       String?
  description String?
  stock       Int?      @default(0)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
}

model tables {
  id           Int            @id @default(autoincrement())
  table_number String         @unique @db.VarChar(20)
  status       String?        @default("available") @db.VarChar(20)
  transactions transactions[]
}

model transactions {
  id             Int       @id @default(autoincrement())
  total_amount   Decimal   @db.Decimal(12, 2)
  table_id       String?   @db.VarChar(20)
  employee_id    Int?
  status         String?   @default("pending") @db.VarChar(20)
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  payment_method String?   @default("cash") @db.VarChar(20)
  items          Json?     @default("[]")
  employee       employees? @relation(fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  table          tables?    @relation(fields: [table_id], references: [table_number], onDelete: NoAction, onUpdate: NoAction)
}
